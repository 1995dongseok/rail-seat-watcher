[Unit]
Description=Rail Seat Watcher (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/rail-seat-watcher
ExecStart=/opt/rail-seat-watcher/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Seoul

[Install]
WantedBy=multi-user.target
