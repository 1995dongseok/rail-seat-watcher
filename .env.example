# 텔레그램 봇 토큰(@BotFather 발급). 봇은 서버에 하나만 두고, 받는 사람은 사용자별 chat_id 로 구분합니다.
TELEGRAM_BOT_TOKEN=

# 가입 초대코드. 이 값을 아는 사람만 계정을 만들 수 있습니다. 비워 두면 가입이 막힙니다.
INVITE_CODE=

# 관리자 계정의 사용자명. 이 이름으로 가입한 계정이 /admin 에서 사용 허용/거부와 chat_id 를 관리합니다.
ADMIN_USERNAME=admin

# 감시 조회 주기(초). 사용자와 감시 건수가 늘수록 넉넉히 잡으세요. 최소 30, 기본 60
POLL_INTERVAL_SEC=120

# 서버 바인딩. 지인이 같은 네트워크에서 접속하려면 HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000

# 항공 가격 조회: SerpApi Google Flights API 키 (https://serpapi.com/google-flights-api)
SERPAPI_API_KEY=
